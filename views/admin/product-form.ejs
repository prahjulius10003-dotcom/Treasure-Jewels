<%- include('../partials/admin-header') %>
<div class="admin-content">
  <h4 class="mb-4"><%= product ? 'Edit Product' : 'Add New Product' %></h4>
  <div class="checkout-card" style="max-width:640px">
    <form action="<%= product ? '/admin/products/'+product.id+'?_method=PUT' : '/admin/products' %>" method="POST" enctype="multipart/form-data">
      <div class="row g-3">
        <div class="col-12">
          <label class="form-label">Product Name *</label>
          <input type="text" name="name" class="form-control" value="<%= product ? product.name : '' %>" required/>
        </div>
        <div class="col-12">
          <label class="form-label">Description</label>
          <textarea name="description" class="form-control" rows="3"><%= product ? product.description : '' %></textarea>
        </div>
        <div class="col-md-6">
          <label class="form-label">Selling Price (GHS) *</label>
          <input type="number" name="price" step="0.01" class="form-control" value="<%= product ? product.price : '' %>" required/>
        </div>
        <div class="col-md-6">
          <label class="form-label">Original Price (GHS) <small class="text-muted">for showing discount</small></label>
          <input type="number" name="original_price" step="0.01" class="form-control" value="<%= product && product.original_price ? product.original_price : '' %>"/>
        </div>
        <div class="col-md-6">
          <label class="form-label">Stock Quantity *</label>
          <input type="number" name="stock" class="form-control" value="<%= product ? product.stock : 10 %>" required/>
        </div>
        <div class="col-md-6">
          <label class="form-label">Badge <small class="text-muted">(e.g. New, Sale, Bestseller)</small></label>
          <input type="text" name="badge" class="form-control" value="<%= product ? product.badge : '' %>" placeholder="Leave blank for none"/>
        </div>
        <div class="col-12">
          <label class="form-label">Category *</label>
          <select name="category" class="form-select" required>
            <option value="">Select...</option>
            <% ['Tote Bags','Crossbody Bags','Travel Bags','Beach Bags','Work Bags','Shoulder Bags','Clutches','Backpacks'].forEach(cat => { %>
            <option value="<%= cat %>" <%= product && product.category===cat ? 'selected' : '' %>><%= cat %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-12">
          <label class="form-label">Product Image</label>
          <input type="file" name="image" class="form-control" accept="image/*"/>
          <% if(product && product.image) { %>
          <div class="mt-2 d-flex align-items-center gap-2">
            <img src="/images/<%= product.image %>" width="60" height="60" style="object-fit:cover;border-radius:6px" onerror="this.src='/images/default-bag.jpg'"/>
            <small class="text-muted">Current image. Upload a new one to replace it.</small>
          </div>
          <% } %>
        </div>
        <div class="col-md-6">
          <div class="form-check mt-2">
            <input type="checkbox" name="is_featured" class="form-check-input" id="isFeatured" <%= product && product.is_featured ? 'checked' : '' %>/>
            <label class="form-check-label" for="isFeatured">Featured on Homepage</label>
          </div>
        </div>
        <div class="col-md-6">
          <div class="form-check mt-2">
            <input type="checkbox" name="is_new" class="form-check-input" id="isNew" <%= product && product.is_new ? 'checked' : '' %>/>
            <label class="form-check-label" for="isNew">Mark as New Arrival</label>
          </div>
        </div>
        <div class="col-12 mt-3 d-flex gap-2">
          <button type="submit" class="btn btn-dark"><%= product ? 'Update Product' : 'Add Product' %></button>
          <a href="/admin/products" class="btn btn-outline-secondary">Cancel</a>
        </div>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/admin-footer') %>
