<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Reset Admin Password – Treasure Jewels</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body class="admin-body">
<div class="admin-login-wrap">
  <div class="admin-login-card">
    <h4>&#10022; Treasure Jewels</h4>
    <p class="text-muted small">Reset your admin password using your secure reset token.</p>
    <% if(error && error.length > 0) { %>
    <div class="alert alert-danger"><%= error %></div>
    <% } %>
    <% if(success && success.length > 0) { %>
    <div class="alert alert-success"><%= success %></div>
    <% } %>
    <% if(!resetEnabled) { %>
      <div class="alert alert-warning small">Password reset is not enabled. Set <code>ADMIN_RESET_TOKEN</code> in your environment and restart the app.</div>
    <% } %>
    <form action="/admin/reset" method="POST">
      <div class="mb-3">
        <input type="text" name="reset_token" class="form-control" placeholder="Reset token" <%= !resetEnabled ? 'disabled' : '' %> required/>
      </div>
      <div class="mb-3">
        <input type="password" name="new_password" class="form-control" placeholder="New password" <%= !resetEnabled ? 'disabled' : '' %> required/>
      </div>
      <div class="mb-3">
        <input type="password" name="confirm_password" class="form-control" placeholder="Confirm new password" <%= !resetEnabled ? 'disabled' : '' %> required/>
      </div>
      <button type="submit" class="btn btn-dark w-100" <%= !resetEnabled ? 'disabled' : '' %>>Reset Password</button>
    </form>
    <div class="mt-3 text-center">
      <a href="/admin/login" class="text-decoration-none small">Back to login</a>
    </div>
  </div>
</div>
</body>
</html>
