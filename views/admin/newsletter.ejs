<%- include('../partials/admin-header') %>
<div class="admin-content">
  <div class="admin-page-header">
    <h4>Newsletter Subscribers (<%= subscribers.length %>)</h4>
    <a href="/admin/newsletter/export" class="btn btn-sm btn-outline-dark"><i class="bi bi-download me-1"></i>Export CSV</a>
  </div>
  <div class="table-responsive">
    <table class="table admin-table">
      <thead><tr><th>#</th><th>Email</th><th>Subscribed On</th></tr></thead>
      <tbody>
        <% subscribers.forEach((s,i) => { %>
        <tr>
          <td><%= i+1 %></td>
          <td><%= s.email %></td>
          <td><%= new Date(s.created_at).toLocaleDateString('en-GB') %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/admin-footer') %>
