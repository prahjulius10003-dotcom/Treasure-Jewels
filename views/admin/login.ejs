<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin Login – Treasure Jewels</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body class="admin-body">
<div class="admin-login-wrap">
  <div class="admin-login-card">
    <h4>&#10022; Treasure Jewels</h4>
    <p class="text-muted small">Enter your admin password to continue</p>
    <% if(error && error.length > 0) { %>
    <div class="alert alert-danger"><%= error %></div>
    <% } %>
    <form action="/admin/login" method="POST">
      <div class="mb-3">
        <input type="password" name="password" class="form-control" placeholder="Admin password" required autofocus/>
      </div>
      <button type="submit" class="btn btn-dark w-100">Login</button>
    </form>
    <div class="mt-3 text-center">
      <a href="/admin/reset" class="text-decoration-none small">Forgot password?</a>
    </div>
  </div>
</div>
</body>
</html>
