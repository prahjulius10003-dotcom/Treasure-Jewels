<%- include('partials/header') %>
<section class="section-pad">
  <div class="container">
    <h2 class="mb-4"><i class="bi bi-heart-fill text-danger me-2"></i>My Wishlist</h2>
    <% if(products.length === 0) { %>
    <div class="empty-state">
      <i class="bi bi-heart"></i>
      <h5>Your wishlist is empty</h5>
      <p class="text-muted">Save items you love and come back to them anytime.</p>
      <a href="/shop" class="btn-gold mt-3">Browse Bags</a>
    </div>
    <% } else { %>
    <div class="row g-4">
      <% products.forEach(product => { %>
      <div class="col-6 col-md-3">
        <%- include('partials/product-card', { product, wishlist }) %>
      </div>
      <% }) %>
    </div>
    <% } %>
  </div>
</section>
<%- include('partials/footer') %>
