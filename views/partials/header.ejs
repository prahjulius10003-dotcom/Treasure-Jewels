<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Treasure Jewels Ghana — Premium Bags Delivered</title>
  <meta name="description" content="Shop premium bags in Ghana. Tote bags, crossbody bags, travel bags and more. Pay with MoMo or card. Fast delivery nationwide."/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body>

<!-- Top announcement bar -->
<div class="announce-bar">
  <span><i class="bi bi-truck"></i> Free delivery on orders above GH&#8373;300 &nbsp;|&nbsp; <i class="bi bi-phone"></i> Pay with MTN MoMo | AirtelTigo | Telecel | Visa | &amp; Mastercard</span>
</div>

<nav class="navbar navbar-expand-lg sticky-top" id="mainNav">
  <div class="container">
    <a class="navbar-brand" href="/">
      <span class="brand-star">&#10022;</span> Treasure Jewels
    </a>
    <div class="d-flex align-items-center gap-3 d-lg-none">
      <a href="/wishlist" class="nav-icon-btn"><i class="bi bi-heart"></i></a>
      <a href="/cart" class="nav-icon-btn position-relative">
        <i class="bi bi-bag"></i>
        <% if(cartCount > 0) { %><span class="cart-badge"><%= cartCount %></span><% } %>
      </a>
      <button class="navbar-toggler border-0 p-0" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
        <i class="bi bi-list fs-4"></i>
      </button>
    </div>
    <div class="collapse navbar-collapse" id="navMenu">
      <ul class="navbar-nav mx-auto gap-1">
        <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="/shop" data-bs-toggle="dropdown">Shop</a>
          <ul class="dropdown-menu mega-menu">
            <li><a class="dropdown-item" href="/shop">All Bags</a></li>
            <li><hr class="dropdown-divider"/></li>
            <li><a class="dropdown-item" href="/shop?category=Tote+Bags"><i class="bi bi-bag me-2"></i>Tote Bags</a></li>
            <li><a class="dropdown-item" href="/shop?category=Crossbody+Bags"><i class="bi bi-bag me-2"></i>Crossbody Bags</a></li>
            <li><a class="dropdown-item" href="/shop?category=Work+Bags"><i class="bi bi-briefcase me-2"></i>Work Bags</a></li>
            <li><a class="dropdown-item" href="/shop?category=Travel+Bags"><i class="bi bi-airplane me-2"></i>Travel Bags</a></li>
            <li><a class="dropdown-item" href="/shop?category=Beach+Bags"><i class="bi bi-sun me-2"></i>Beach Bags</a></li>
            <li><a class="dropdown-item" href="/shop?category=Shoulder+Bags"><i class="bi bi-bag me-2"></i>Shoulder Bags</a></li>
            <li><a class="dropdown-item" href="/shop?category=Clutches"><i class="bi bi-handbag me-2"></i>Clutches</a></li>
            <li><a class="dropdown-item" href="/shop?category=Backpacks"><i class="bi bi-backpack me-2"></i>Backpacks</a></li>
          </ul>
        </li>
        <li class="nav-item"><a class="nav-link" href="/shop?sort=newest">New Arrivals</a></li>
        <li class="nav-item"><a class="nav-link" href="/track-order">Track Order</a></li>
      </ul>
      <div class="d-flex align-items-center gap-3">
        <button class="search-toggle" id="searchToggle"><i class="bi bi-search"></i></button>
        <a href="/wishlist" class="nav-icon-btn d-none d-lg-flex"><i class="bi bi-heart"></i></a>
        <a href="/cart" class="nav-icon-btn d-none d-lg-flex position-relative">
          <i class="bi bi-bag"></i>
          <% if(cartCount > 0) { %><span class="cart-badge"><%= cartCount %></span><% } %>
        </a>
      </div>
    </div>
  </div>
</nav>

<!-- Search bar overlay -->
<div class="search-overlay" id="searchOverlay">
  <div class="container">
    <form action="/shop" method="GET" class="search-form">
      <i class="bi bi-search"></i>
      <input type="text" name="search" placeholder="Search for bags..." autofocus/>
      <button type="button" class="search-close" id="searchClose"><i class="bi bi-x-lg"></i></button>
    </form>
  </div>
</div>

<% if(success && success.length > 0) { %>
<div class="toast-notification success" id="toastMsg"><i class="bi bi-check-circle-fill"></i> <%= success %></div>
<% } %>
<% if(error && error.length > 0) { %>
<div class="toast-notification error" id="toastMsg"><i class="bi bi-exclamation-circle-fill"></i> <%= error %></div>
<% } %>
