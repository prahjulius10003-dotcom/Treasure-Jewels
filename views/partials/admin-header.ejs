<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>Admin — Treasure Jewels</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css"/>
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body class="admin-body">
<div class="admin-layout">
  <aside class="admin-sidebar">
    <div class="sidebar-brand">&#10022; Treasure Jewels</div>
    <nav class="sidebar-nav">
      <a href="/admin"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a>
      <a href="/admin/products"><i class="bi bi-bag"></i><span>Products</span></a>
      <a href="/admin/orders"><i class="bi bi-list-check"></i><span>Orders</span></a>
      <a href="/admin/reviews"><i class="bi bi-star"></i><span>Reviews</span></a>
      <a href="/admin/profile"><i class="bi bi-person"></i><span>Profile</span></a>
      <a href="/admin/newsletter"><i class="bi bi-envelope"></i><span>Newsletter</span></a>
      <a href="/" target="_blank"><i class="bi bi-shop"></i><span>View Store</span></a>
      <a href="/admin/logout" class="logout-link"><i class="bi bi-box-arrow-left"></i><span>Logout</span></a>
    </nav>
  </aside>
  <main class="admin-main">
    <% if(typeof success !== 'undefined' && success && success.length > 0) { %>
    <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle me-2"></i><%= success %><button class="btn-close" data-bs-dismiss="alert"></button></div>
    <% } %>
    <% if(typeof error !== 'undefined' && error && error.length > 0) { %>
    <div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-circle me-2"></i><%= error %><button class="btn-close" data-bs-dismiss="alert"></button></div>
    <% } %>
    <div class="admin-topbar">
      <div class="admin-topbar-title">
        <img src="/images/<%= adminImage || 'avatar-placeholder.svg' %>" alt="Profile" class="admin-avatar" />
        <span><%= adminName %></span>
      </div>
      <a href="/admin/profile" class="btn btn-outline-dark btn-sm"><i class="bi bi-person-circle me-1"></i>Profile</a>
    </div>
