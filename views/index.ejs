<%- include('partials/header') %>

<!-- Hero Slider -->
<section class="hero">
  <div class="hero-slides">
    <div class="hero-slide active">
      <div class="hero-bg" style="background-image:url('/images/default-bag.jpg')"></div>
      <div class="container h-100">
        <div class="hero-content">
          <p class="hero-eyebrow">New Collection — 2026</p>
          <h1>Bags That Tell<br/><em>Your Story</em></h1>
          <p class="hero-desc">Discover handpicked bags for every occasion, from beach days to boardrooms. Delivered across Ghana.</p>
          <div class="hero-actions">
            <a href="/shop" class="btn-gold">Shop Now <i class="bi bi-arrow-right ms-1"></i></a>
            <a href="/shop?sort=newest" class="btn-ghost">New Arrivals</a>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="hero-scroll-hint"><span>Scroll to explore</span><i class="bi bi-chevron-down"></i></div>
</section>

<!-- Trust bar -->
<div class="trust-bar">
  <div class="container">
    <div class="trust-items">
      <div class="trust-item"><i class="bi bi-truck"></i><span>Nationwide Delivery</span></div>
      <div class="trust-item"><i class="bi bi-shield-check"></i><span>Secure Payments</span></div>
      <div class="trust-item"><i class="bi bi-arrow-repeat"></i><span>7-Day Returns</span></div>
      <div class="trust-item"><i class="bi bi-headset"></i><span>WhatsApp Support</span></div>
      <div class="trust-item"><i class="bi bi-award"></i><span>100% Authentic</span></div>
    </div>
  </div>
</div>

<!-- Category Grid -->
<section class="section-pad">
  <div class="container">
    <div class="section-header">
      <h2>Shop by Category</h2>
      <a href="/shop" class="see-all">See all <i class="bi bi-arrow-right"></i></a>
    </div>
    <div class="category-grid">
      <% const catIcons = {'Tote Bags':'bag','Crossbody Bags':'bag-heart','Travel Bags':'airplane','Beach Bags':'sun','Work Bags':'briefcase','Shoulder Bags':'bag-plus','Clutches':'handbag','Backpacks':'backpack'}; %>
      <% categories.forEach((cat, i) => { %>
      <a href="/shop?category=<%= encodeURIComponent(cat.category) %>" class="cat-tile cat-tile-<%= (i%4)+1 %>">
        <i class="bi bi-<%= catIcons[cat.category] || 'bag' %>"></i>
        <span><%= cat.category %></span>
      </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- Featured Products -->
<section class="section-pad bg-cream">
  <div class="container">
    <div class="section-header">
      <h2>Featured Bags</h2>
      <a href="/shop" class="see-all">View all <i class="bi bi-arrow-right"></i></a>
    </div>
    <div class="row g-4">
      <% featured.forEach(product => { %>
      <div class="col-6 col-md-4">
        <%- include('partials/product-card', { product }) %>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- Banner CTA -->
<section class="promo-banner">
  <div class="container">
    <div class="promo-inner">
      <div>
        <p class="promo-eyebrow">Limited Time Offer</p>
        <h3>Up to 25% Off<br/>Travel & Work Bags</h3>
        <a href="/shop?category=Travel+Bags" class="btn-gold mt-3">Shop Sale <i class="bi bi-lightning-fill"></i></a>
      </div>
    </div>
  </div>
</section>

<!-- New Arrivals -->
<section class="section-pad">
  <div class="container">
    <div class="section-header">
      <h2>New Arrivals</h2>
      <a href="/shop?sort=newest" class="see-all">See all <i class="bi bi-arrow-right"></i></a>
    </div>
    <div class="row g-4">
      <% newArrivals.forEach(product => { %>
      <div class="col-6 col-md-3">
        <%- include('partials/product-card', { product }) %>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- Bestsellers strip -->
<section class="section-pad bg-cream">
  <div class="container">
    <div class="section-header">
      <h2>Customer Favourites</h2>
      <a href="/shop?sort=popular" class="see-all">See all <i class="bi bi-arrow-right"></i></a>
    </div>
    <div class="row g-4">
      <% bestsellers.forEach(product => { %>
      <div class="col-6 col-md-3">
        <%- include('partials/product-card', { product }) %>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- Testimonials -->
<section class="section-pad testimonials-section">
  <div class="container">
    <h2 class="text-center mb-5">What Our Customers Say</h2>
    <div class="row g-4">
      <div class="col-md-4">
        <div class="testimonial-card">
          <div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <p>"Got the Classic Leather Tote and I absolutely love it. The quality is outstanding and delivery was the next day!"</p>
          <div class="t-author"><div class="t-avatar">AK</div><div><strong>Akosua K.</strong><span>Accra</span></div></div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="testimonial-card featured-testimonial">
          <div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <p>"Best bag shop in Ghana! I paid with MoMo and my order arrived the same afternoon. Will definitely buy again."</p>
          <div class="t-author"><div class="t-avatar">KA</div><div><strong>Kwame A.</strong><span>Kumasi</span></div></div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="testimonial-card">
          <div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <p>"The Kente Clutch is beyond beautiful. Everyone at the event asked where I got it. Highly recommend!"</p>
          <div class="t-author"><div class="t-avatar">EA</div><div><strong>Esi A.</strong><span>Tema</span></div></div>
        </div>
      </div>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
